# Copy to .env and fill in. The .env file is gitignored and never leaves the machine.

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-the-command-above

# Admin bootstrap: created at first startup if it doesn't exist yet.
# The password is only used at creation time (it is NOT re-applied on restart).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database. In Docker this is overridden to /app/data/poghiamo.db by compose.
DATABASE_URL=sqlite:///./poghiamo.db

# Public base URL, used to build invite links shown in the admin settings.
# In production: https://poghiamo.quest
WEBAPP_URL=http://localhost:8000

# Set to false ONLY for local development over plain http, otherwise the
# session cookie (marked Secure) would never be stored by the browser.
SESSION_HTTPS_ONLY=true

# Nightly backups: destination directory and how many files to keep.
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Events pipeline
SCAN_INTERVAL_DAYS=7
SOURCE_TIMEOUT_SECONDS=25
SCAN_BATCH_SIZE=20
EVENT_STALE_DAYS=7
# Ticketmaster Discovery API key (free at developer-account.ticketmaster.com).
# Leave empty to disable that source.
TICKETMASTER_API_KEY=
# ScraperAPI key: lets the rockol adapter fetch through a residential IP with JS
# rendering (rockol's Cloudflare blocks the VPS directly). Empty = rockol off.
SCRAPERAPI_KEY=
# Proxy tier for rockol: ultra_premium (usually needed for Cloudflare, 75
# credits/request with render), premium (25), or empty (standard).
ROCKOL_PROXY_TIER=ultra_premium
# Monthly cap on rockol scraping requests (free tier is 1000 credits/month;
# 1000 / 75 ≈ 13). Keep it conservative.
ROCKOL_MONTHLY_BUDGET=12
