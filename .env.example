# Copy to .env and fill in. The .env file is gitignored and never leaves the machine.

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-the-command-above

# Admin bootstrap: created at first startup if it doesn't exist yet.
# The password is only used at creation time (it is NOT re-applied on restart).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database. In Docker this is overridden to /app/data/poghiamo.db by compose.
DATABASE_URL=sqlite:///./poghiamo.db

# Public base URL, used to build invite links shown in the admin settings.
# In production: https://poghiamo.quest
WEBAPP_URL=http://localhost:8000

# Set to false ONLY for local development over plain http, otherwise the
# session cookie (marked Secure) would never be stored by the browser.
SESSION_HTTPS_ONLY=true

# Nightly backups: destination directory and how many files to keep.
BACKUP_DIR=./backups
BACKUP_KEEP=14
