# Copy to .env and fill in. The .env file is gitignored and never leaves the machine.

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-the-command-above

# Admin bootstrap: created at first startup if it doesn't exist yet.
# The password is only used at creation time (it is NOT re-applied on restart).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database. In Docker this is overridden to /app/data/poghiamo.db by compose.
DATABASE_URL=sqlite:///./poghiamo.db

# Public base URL, used to build invite links shown in the admin settings.
# In production: https://poghiamo.quest
WEBAPP_URL=http://localhost:8000

# Set to false ONLY for local development over plain http, otherwise the
# session cookie (marked Secure) would never be stored by the browser.
SESSION_HTTPS_ONLY=true

# Nightly backups: destination directory and how many files to keep.
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Events pipeline
SCAN_INTERVAL_DAYS=7
SOURCE_TIMEOUT_SECONDS=25
SCAN_BATCH_SIZE=20
EVENT_STALE_DAYS=7
# Ticketmaster Discovery API key (free at developer-account.ticketmaster.com).
# Leave empty to disable that source.
TICKETMASTER_API_KEY=
# Browser User-Agent for the scraped sites; empty = the built-in recent Chrome.
# Cloudflare challenges stale browser versions: update it when rockol starts
# showing up as "blocked" on the admin source-health card.
# SCRAPER_USER_AGENT=
# rockol's Cloudflare blocks the VPS directly, so the fetch needs another exit.
# Home path: forward proxy on the always-on home PC, reached over WireGuard
# (e.g. http://10.77.0.2:8888). Tried first when set; empty = no home path.
ROCKOL_PROXY_URL=
# Hours to keep the home line away from rockol after rockol blocks it.
ROCKOL_HOME_COOLDOWN_HOURS=6
# ZenRows key: rented residential proxy with JS rendering. Used alone, or as the
# fallback when the home path is down or blocked. rockol is off when both this
# and ROCKOL_PROXY_URL are empty.
ZENROWS_API_KEY=
# Monthly cap on ZenRows-served rockol fetches (home-path fetches do not count).
# ZenRows free tier is 5000 credits/month; a hard fetch (js_render +
# premium_proxy) = 25 credits → 200/mo.
ROCKOL_MONTHLY_BUDGET=180
